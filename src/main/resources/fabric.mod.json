{
	"schemaVersion": 1,
	"id": "controlmobspawns",
	"version": "${version}",
	"name": "Control Mob Spawns",
	"description": "Disable mobs, adjust spawn rates, mob caps, despawn and spawn rules from an in-game menu.",
	"authors": [
		"Heet"
	],
	"license": "MIT",
	"icon": {
		"64": "assets/controlmobspawns/logo-64.png",
		"128": "assets/controlmobspawns/logo-128.png"
	},
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.heet.controlmobspawns.ControlMobSpawns"
		],
		"client": [
			"com.heet.controlmobspawns.client.ControlMobSpawnsClient"
		],
		"modmenu": [
			"com.heet.controlmobspawns.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"controlmobspawns.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"yet_another_config_lib_v3": "*",
		"modmenu": "*"
	}
}
